# Servidor
PORT=3000
HOST=0.0.0.0
BASE_URL=http://127.0.0.1:3000
NODE_ENV=development
# Detrás de un proxy HTTPS (Render, Railway, etc.) usa true.
TRUST_PROXY=false

# Sesión firmada (cookie-session). En producción usa 32+ caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here_change_in_production

# Spotify OAuth 2.0 + PKCE
# El redirect debe coincidir exactamente con el configurado en Spotify Dashboard.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
SPOTIFY_MARKET=ES

# Ticketmaster Discovery API
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key

# Genius API
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Musixmatch
MUSIXMATCH_API_KEY=your_musixmatch_api_key
